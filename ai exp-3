import heapq

def a_star(graph, start, goal, heuristic):
    open_list = []
    heapq.heappush(open_list, (0, start))
    
    g_cost = {start: 0}
    parent = {start: None}
    
    while open_list:
        _, current = heapq.heappop(open_list)
        
        if current == goal:
            path = []
            while current:
                path.append(current)
                current = parent[current]
            return path[::-1]
        
        for neighbor, cost in graph[current]:
            new_g = g_cost[current] + cost
            
            if neighbor not in g_cost or new_g < g_cost[neighbor]:
                g_cost[neighbor] = new_g
                f_cost = new_g + heuristic[neighbor]
                heapq.heappush(open_list, (f_cost, neighbor))
                parent[neighbor] = current
    
    return None


# ---- Taking Input ----
n = int(input("Enter number of nodes: "))

graph = {}

print("Enter neighbors with weights (format: neighbor weight):")
for i in range(n):
    node = input(f"Node name: ")
    neighbors_input = input(f"Enter neighbors of {node}: ").strip()

    edges = []
    if neighbors_input != "":
        parts = neighbors_input.split()
        for j in range(0, len(parts), 2):
            neighbor = parts[j]
            weight = int(parts[j + 1])
            edges.append((neighbor, weight))

    graph[node] = edges

# Heuristic input
heuristic = {}
print("Enter heuristic values:")
for i in range(n):
    node = input("Node: ")
    h = int(input(f"Heuristic value for {node}: "))
    heuristic[node] = h

start = input("Enter start node: ")
goal = input("Enter goal node: ")

# ---- Call A* ----
path = a_star(graph, start, goal, heuristic)

if path:
    print("Path found:", path)
else:
    print("No path found")
