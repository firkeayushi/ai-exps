✅ Example 3: Doctor–Patient (Hospital System)
% ----------- Facts -----------

doctor(dr_smith).
doctor(dr_khan).

patient(rahul).
patient(sneha).
patient(amit).

disease(fever).
disease(covid).

% Doctor treats disease
treats(dr_smith, fever).
treats(dr_khan, covid).

% Patient has disease
has_disease(rahul, fever).
has_disease(sneha, covid).
has_disease(amit, fever).

% ----------- Rules -----------

% Doctor treats patient
treats_patient(Doctor, Patient) :-
    treats(Doctor, Disease),
    has_disease(Patient, Disease).

% Patients with same disease
same_disease(X, Y) :-
    has_disease(X, D),
    has_disease(Y, D),
    X \= Y.

% Doctor assigned to patient
assigned_doctor(Patient, Doctor) :-
    treats_patient(Doctor, Patient).

% Check if patient is under same doctor
same_doctor(X, Y) :-
    assigned_doctor(X, D),
    assigned_doctor(Y, D),
    X \= Y.
________________________________________
🧪 Queries
🔹 Which doctor treats Rahul?
?- assigned_doctor(rahul, X).
👉 Output:
X = dr_smith.
________________________________________
🔹 Patients treated by Dr. Khan
?- treats_patient(dr_khan, X).
👉 Output:
X = sneha.
________________________________________
🔹 Patients with same disease
?- same_disease(rahul, X).
👉 Output:
X = amit.
