✅ Example 1: College / Student–Teacher System (Prolog)
% ----------- Facts -----------

% Students
student(rahul).
student(sneha).
student(amit).
student(priya).

% Teachers
teacher(dr_smith).
teacher(dr_khan).

% Subjects
subject(math).
subject(ai).
subject(dbms).

% Teacher teaches subject
teaches(dr_smith, math).
teaches(dr_smith, ai).
teaches(dr_khan, dbms).

% Students enrolled in subjects
enrolled(rahul, math).
enrolled(rahul, ai).
enrolled(sneha, ai).
enrolled(amit, dbms).
enrolled(priya, math).

% ----------- Rules -----------

% A teacher teaches a student if student is enrolled in subject
teaches_student(Teacher, Student) :-
    teaches(Teacher, Subject),
    enrolled(Student, Subject).

% Classmates (same subject)
classmate(X, Y) :-
    enrolled(X, Subject),
    enrolled(Y, Subject),
    X \= Y.

% Student studies under teacher
studies_under(Student, Teacher) :-
    teaches(Teacher, Subject),
    enrolled(Student, Subject).

% Common teacher between two students
common_teacher(X, Y, Teacher) :-
    studies_under(X, Teacher),
    studies_under(Y, Teacher),
    X \= Y.

% Students taking multiple subjects
multi_subject_student(Student) :-
    enrolled(Student, S1),
    enrolled(Student, S2),
    S1 \= S2.
________________________________________
🧪 Execution Queries (VERY IMPORTANT)
🔹 1. Who are students taught by Dr. Smith?
?- teaches_student(dr_smith, X).
👉 Output:
X = rahul ;
X = sneha ;
X = priya.
________________________________________
🔹 2. Find classmates of Rahul
?- classmate(rahul, X).
👉 Output:
X = sneha ;
X = priya.
________________________________________
🔹 3. Which teacher teaches Rahul?
?- studies_under(rahul, X).
👉 Output:
X = dr_smith.
________________________________________
🔹 4. Students having common teacher
?- common_teacher(rahul, sneha, T).
👉 Output:
T = dr_smith.
________________________________________
🔹 5. Students studying multiple subjects
?- multi_subject_student(X).
👉 Output:
X = rahul.
✅ Example 2: Employee–Manager System
% ----------- Facts -----------

employee(rahul).
employee(sneha).
employee(amit).
employee(priya).

manager(boss1).
manager(boss2).

% Works under
works_under(rahul, boss1).
works_under(sneha, boss1).
works_under(amit, boss2).
works_under(priya, boss2).

% ----------- Rules -----------

% Colleagues (same manager)
colleague(X, Y) :-
    works_under(X, M),
    works_under(Y, M),
    X \= Y.

% Manager of employee
is_manager(M, E) :-
    works_under(E, M).

% Employees under same manager group
team_member(X, Y) :-
    colleague(X, Y).

% Employee works in organization
works(X) :-
    employee(X).

% Manager supervises employee
supervises(M, E) :-
    manager(M),
    works_under(E, M).
