        print(f"Step 3: Monkey pushes box from {b_pos} to {target}")
        m_pos = target
        b_pos = target
    else:
        print(f"Step 3: Box is already under the banana (Position {target})")
    
    print(f"Step 4: Monkey climbs onto the box at {target}")
    print(f"Step 5: Monkey reaches up and grabs the banana")
