        if board[row][i] == 1:
            return False

    # Check upper-left diagonal
    i, j = row, col
    while i >= 0 and j >= 0:
        if board[i][j] == 1:
            return False
        i -= 1
        j -= 1

    # Check lower-left diagonal
    i, j = row, col
    while i < N and j >= 0:
        if board[i][j] == 1:
            return False
        i += 1
        j -= 1

    return True


def solve_n_queens(board, col, N):
    # Base case: all queens are placed
    if col >= N:
        return True

    # Try placing queen in all rows of current column
    for i in range(N):
        if is_safe(board, i, col, N):
            board[i][col] = 1   # Place queen

            # Recur for next column
            if solve_n_queens(board, col + 1, N):
                return True

            board[i][col] = 0   # Backtrack (remove queen)

    return False


def print_stepwise(board, N):
    # Temporary board to show step-by-step placement
    temp = [[0]*N for _ in range(N)]

    for col in range(N):
        for row in range(N):
            if board[row][col] == 1:
                temp[row][col] = 1

                print(f"\nQUEEN {col+1} PLACED")
                for i in range(N):
                    for j in range(N):
                        print("Q" if temp[i][j] == 1 else ".", end=" ")
                    print()
                print("-" * 30)


